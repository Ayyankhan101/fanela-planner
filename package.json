{
  "name": "fanela-app",
  "version": "0.2.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node db/migrate.mjs",
    "db:security": "./db/migrate-all.sh",
    "db:seed": "tsx db/seed.mts",
    "user:add": "tsx scripts/add-user.mts",
    "storage:sweep": "tsx scripts/storage-sweep.mts",
    "outbox:worker": "tsx scripts/outbox-worker.mts",
    "setup": "npm run db:migrate && npm run db:security && npm run db:seed && npm run lint && npm run typecheck && npm test",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "next": "16.3.7",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.36.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
