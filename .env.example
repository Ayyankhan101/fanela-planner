# Fanela — runtime environment contract (copy to .env and edit)
#   cp .env.example .env && chmod 600 .env   # 600 is mandatory — docs/ops/secrets.md

# Required. Owner/superuser connection — db:migrate, db:security, db:seed, and the
# app's own queries all go through this URL.
DATABASE_URL=postgres://fanela:fanela_dev@localhost:5432/fanela

# Optional — dev seed admin (defaults apply when unset):
#   SEED_ADMIN_EMAIL=admin@fanela.local
#   SEED_ADMIN_PASSWORD=ChangeMe123!
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Optional — test-only app-role override for tests/db-security.test.ts.
# Defaults to the fanela_app TCP URL (postgres://fanela_app:fanela_app_dev@localhost:5432/fanela)
# when unset. The app itself never reads this.
# APP_DATABASE_URL=

# Optional — storage policy (E5). Defaults shown; production may tighten.
# STORAGE_QUOTA_BYTES=5368709120     # upload dir cap; next upload over cap → 413 import_storage_quota
# UPLOAD_RETENTION_DAYS=90           # originals kept this long (B2 floor: 90), then nightly sweep removes them

# AUTH_SECRET in an existing .env is vestigial — sessions are DB-backed,
# nothing in the codebase reads it. Safe to delete.
# AUTH_SECRET=

# Auth cookies are Secure in production by default. Set to false ONLY for
# plain-HTTP deployments (e.g. office LAN behind nginx without TLS) —
# browsers reject Secure cookies set over http:// on non-localhost origins.
# AUTH_COOKIE_SECURE=false
